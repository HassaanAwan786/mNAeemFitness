# GEMINI_API_KEY: Required for live Coach mNaeem chat replies.
# 1. Get a free key at https://aistudio.google.com/apikey.  or you can use the api of the Groq console (https://console.groq.com/keys) for free, no credit card needed.
# 2. Paste it below (no quotes needed)
# 3. Restart the dev server: npm run dev
GEMINI_API_KEY=

#Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
